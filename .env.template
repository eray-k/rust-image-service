# Database connection URL
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database-name>

# Directory to store uploaded files, if not set defaults to ./uploads
UPLOAD_DIR=./uploads
# Store images in this S3(-compatible) bucket instead of UPLOAD_DIR. Credentials, region and
# endpoint come from the standard AWS_* variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION, and for MinIO and the like AWS_ENDPOINT (+ AWS_ALLOW_HTTP=true for plain http).
# S3_BUCKET=<bucket>
# Secret used to verify HS256 bearer tokens, at least 32 bytes (e.g. `openssl rand -hex 32`).
# The token's `sub` claim must be the user's UUID.
# Use a secret only this service knows: tokens' `aud`/`iss` claims aren't checked.
JWT_SECRET=<secret>

# Optional TOML file with settings that can be changed while running, see config.example.toml.
# Reloaded on SIGHUP or when its contents change. If not set, defaults are used.
CONFIG_FILE=./config.toml
